{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tanstack-start-app",
  "compatibility_date": "2025-09-02",
  "compatibility_flags": ["nodejs_compat"],
  "main": "./src/worker.ts",
  "vars": {
    "VAPID_SUBJECT": "mailto:admin@adatnama.app",
    "VAPID_PUBLIC_KEY": "BLLN50CkFeTwmlTp-tvfkhxAFh0wDIbddWtsKBurcaX_VazEJPPcd0gQTfaU5pftxhmRvCUsm0xOf2g7NP0Nr_g",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "REMINDER_DO",
        "class_name": "ReminderDurableObject",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ReminderDurableObject"],
    },
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adatnama-db",
      "database_id": "dfbed4a5-3c3c-4e56-b7f2-9f4294ecae33",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "AVATARS_BUCKET",
      "bucket_name": "adatnama-avatars",
      "remote": true,
    },
  ],
}
